{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.claude-plugin/plugin.schema.json",
  "name": "houki-nta-mcp",
  "version": "0.18.1",
  "description": "実装する前に、国税庁の取扱いが条文とどう違うかを確かめるための MCP server。基本通達・改正通達・事務運営指針・文書回答事例・タックスアンサー・質疑応答事例を国税庁サイトから取り込み、「法律で決まっている」と「通達でそうなっている」を混ぜずに、legal_status と根拠条文への案内と鮮度を添えて返す。--quickstart で通達 1 本を約 3〜5 分で試せる。houki-hub family の一員。",
  "author": {
    "name": "shuji-bonji",
    "email": "bonji@mikuro.jp",
    "url": "https://github.com/shuji-bonji"
  },
  "homepage": "https://github.com/shuji-bonji/houki-nta-mcp",
  "repository": "https://github.com/shuji-bonji/houki-nta-mcp",
  "license": "MIT",
  "keywords": ["japan", "tax", "nta", "tsutatsu", "houki", "mcp", "mcp-server"],
  "mcpServers": {
    "houki-nta": {
      "command": "npx",
      "args": ["-y", "@shuji-bonji/houki-nta-mcp@latest"]
    }
  }
}
